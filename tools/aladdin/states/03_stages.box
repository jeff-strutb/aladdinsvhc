# Every act and stage started from the first password: the act ($035C)
# and stage ($035D) are held through the password check and the level
# start, so the level the act and stage table at $80:B73E gives is
# loaded in place of the password's. One state per stage, for random
# play (randplay.py); the work RAM dump beside each says which level it
# is. Stages the passwords start are here too: the scripts that use
# them are pruned by the coverage they add.
load build/aladdin/states/title.state
press DOWN
wait 30
press START
wait 150
press UP
wait 8
press UP
wait 8
press RIGHT
wait 8
press UP
wait 8
press UP
wait 8
press UP
wait 8
press RIGHT
wait 8
press RIGHT
wait 8
press UP
wait 8
press UP
wait 8
press UP
wait 8
press UP
wait 8
press START
repeat 600
poke $00035C 00
poke $00035D 00
wait 1
end
press START
repeat 900
poke $00035C 00
poke $00035D 00
wait 1
end
save stage_a0_s0
dump stage_a0_s0
load build/aladdin/states/title.state
press DOWN
wait 30
press START
wait 150
press UP
wait 8
press UP
wait 8
press RIGHT
wait 8
press UP
wait 8
press UP
wait 8
press UP
wait 8
press RIGHT
wait 8
press RIGHT
wait 8
press UP
wait 8
press UP
wait 8
press UP
wait 8
press UP
wait 8
press START
repeat 600
poke $00035C 00
poke $00035D 01
wait 1
end
press START
repeat 900
poke $00035C 00
poke $00035D 01
wait 1
end
