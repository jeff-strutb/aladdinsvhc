# Each password from the table at $80:FDD5 entered on the password
# screen, saved once the level it selects has started. Slots are
# indexed 3 down to 0 (RIGHT steps down from 3); UP steps a slot's
# portrait up (0-5); START checks the password, and START again skips
# the story card the first six show before their level.
load build/aladdin/states/title.state
press DOWN
wait 30
press START
wait 150
press UP
wait 8
press UP
wait 8
press RIGHT
wait 8
press UP
wait 8
press UP
wait 8
press UP
wait 8
press RIGHT
wait 8
press RIGHT
wait 8
press UP
wait 8
press UP
wait 8
press UP
wait 8
press UP
wait 8
