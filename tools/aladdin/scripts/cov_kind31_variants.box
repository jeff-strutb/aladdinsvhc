# Actor kind $31's start ($83:ABEA) for each variant ($07 bits 0-2, by the
# level: table $83:AC17 below level 2, $83:AC36 from level 2), which the
# levels place with only a few: each variant restarts the live kind $31
# actor (record $0C4B, at x $0B30, as unit_actor31_turn.box brings it in
# from stage a5 s2) with its state set to $0C and $07 the variant; for
# the first table the level ($035C, 5 here) reads 0 for that frame. The
# player is then held where the variant waits for him (each wait compares
# his x, $08E7, with the actor's) so its sequence runs on.
# variant 1, first table, player at x $0AE0
load build/aladdin/states/stage_a5_s2.state
wait 2
poke 0008E7 80,0B
poke 0008EA 80,00
poke 001773 00,0B
wait 98
poke 000C4B 0C
poke 000C52 01
poke 00035C 00
wait 1
poke 00035C 05
repeat 150
poke 0008E7 E0,0A
wait 1
end
wait 300
