# Bank $81 routines no code calls (no JSR, JSL, JMP or table word reaches
# them), each by a unit call at its own entry on the first level at frame
# 10 (the machine is put back after each call):
# ReturnFFLong ($81:ADF9); GroundBehindLong ($81:B799) with D the player,
# facing right (flip 1: GroundLeftLong) and left (flip 0); the parallax
# handlers 2 and 3 ParallaxHalfY ($81:C7B3) and ParallaxHalfXY80
# ($81:C7C1), 16-bit as ParallaxUpdate's JSR (table,X) leaves them;
# PlayerSettleOrHurt ($81:DD88) with D the player standing at y $01B0 (settled, the
# ground not hurting: TILE_BEHAVIOUR 0) and at y $0170, 64 pixels up (not
# settled); TileActorSpawnLong ($81:EA71) with X the tile at offset 0 and
# kind index 0 (kind $10 started at TILE_ACTOR_X/Y), index 5 (the table's
# $FF: none) and index 0 with the free list empty ($15E4 negative: C set).
load build/aladdin/states/level1.state
wait 10
call 81ADF9 long p=30 db=80
set 0008F0 01
call 81B799 long p=30 db=80 d=08DB
set 0008F0 00
call 81B799 long p=30 db=80 d=08DB
call 81C7B3 p=00 db=80
call 81C7C1 p=00 db=80
set 000012 00
call 81DD88 p=30 db=80 d=08DB
set 0008EA 70,01
call 81DD88 p=30 db=80 d=08DB
call 81EA71 long a=0000 x=0000 p=00 db=80
call 81EA71 long a=0005 x=0000 p=00 db=80
set 0015E4 FF
call 81EA71 long a=0000 x=0000 p=00 db=80
