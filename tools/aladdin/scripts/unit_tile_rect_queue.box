# A rectangle of tiles queued for the screen ($81:9BAE, TileRectQueue):
# nothing in the game calls it, so no screen runs it. Unit calls by JSL on
# the first level's state (M and X 16-bit, DB $81, the view at x 0, y
# $100, tile_blocks empty), with A = $0202 (two rows of two) and X = $8000
# (the tiles' words: any bytes of the bank serve). The top left at x $100,
# y $1E0 puts the first column and row in view and the second just out of
# it, so both view tests go both ways. Then with tile_blocks_length set to
# $80: no room, it returns at once. (The machine is put back after each
# call.)
load build/aladdin/states/level1.state
wait 10
set $00002C 00,01,E0,01
call 819BAE long a=0202 x=8000 db=81 p=00
set $001BE4 80,00
call 819BAE long a=0202 x=8000 db=81 p=00
