# ActorProbeAheadInGround ($83:FD6D) finding ground ($83:FDAE), which the
# kind $31 walkers that call it never meet: unit calls at its own entry on
# the first level's state at frame 10, D the guard at record $0BAB (x
# $0125, y $01B0, on the floor), X and Y 0 (both probes at its feet): as it
# stands (no ground there), then with its y set 16 pixels lower ($01C0),
# so the first probe is in the floor.
load build/aladdin/states/level1.state
wait 10
call 83FD6D p=30 db=80 d=0BAB x=00 y=00
set 000BBA C0,01
call 83FD6D p=30 db=80 d=0BAB x=00 y=00
