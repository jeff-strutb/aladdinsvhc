# The subroutine at $83:A9F7 (80 bytes), which nothing calls or jumps to: from the thrown copy of kind $2D's pose ($41, 8 up) and its facing
# ($14) it takes a point to either side of its x ($0C, 8 pixels right, or left when $14 is not 0) and a table row below its y ($0F, from the
# table at $D13C by the pose), asks the map tile there (TileAtProbeLong), and where there is one makes a record of kind $11 (ActorAllocBLong)
# at its place, returning A = 1; none free, or no tile, it returns. Each call is a unit call at its own entry, as a subroutine, with M and X
# 8-bit, DB $80, D the free record $0BAB, on the first level's state at frame 10 and the record's fields set before the call (pose, facing,
# x and y): the points are inside the first screen ($0000-$00FF, $0100-$01DF): only the pose $0C at x $70, y $1C0 meets a tile, as the fifth call
# and the last do; the last call has the second pool's free list empty ($15E6 negative).
load build/aladdin/states/level1.state
wait 10
set 000BEC 08
set 000BBF 00
set 000BB7 90,00
set 000BBA A0,01
call 83A9F7 p=30 db=80 d=0BAB
set 000BEC 09
set 000BBF 01
set 000BB7 90,00
set 000BBA A0,01
call 83A9F7 p=30 db=80 d=0BAB
set 000BEC 0A
set 000BBF 00
set 000BB7 80,00
set 000BBA B0,01
call 83A9F7 p=30 db=80 d=0BAB
set 000BEC 0B
set 000BBF 01
set 000BB7 40,00
set 000BBA 20,01
call 83A9F7 p=30 db=80 d=0BAB
set 000BEC 0C
set 000BBF 00
set 000BB7 70,00
set 000BBA C0,01
call 83A9F7 p=30 db=80 d=0BAB
set 000BEC 0C
set 000BBF 00
set 000BB7 70,00
set 000BBA C0,01
set 0015E6 FF
call 83A9F7 p=30 db=80 d=0BAB
