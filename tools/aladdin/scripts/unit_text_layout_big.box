# Text layouts drawn as large characters ($81:979A, TextLayoutDrawBig):
# nothing in the game calls it, so no screen runs it; unit calls by JSL
# with the game's own layout data. X = 0 (layout 0's first byte 2: two
# characters at tilemap offset $0082) draws a run; X = 4 (layout 2 starts
# with 0) draws nothing. (The machine is put back after each call.)
load build/aladdin/states/level1.state
wait 10
call 81979A long x=0000 db=80 p=30
call 81979A long x=0004 db=80 p=30
