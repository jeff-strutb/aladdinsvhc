# The wait routine at $83:B94A of an actor with variant 7 (its $07's low
# three bits): until it is first hit by a shot ($43), each shot that
# reaches it counts ($83:B956). No script meets one of variant 7 with a
# shot. On pw4.state, a unit call on the actor at $0BAB (its $06 = $30)
# with variant 7; then, on the first level played as unit_pot_hit.box
# until an apple is thrown, the routine on the falling pot's record
# ($0C4B) given variant 7, with the apple moved onto it, as there.
load build/aladdin/states/pw4.state
wait 2
set $000BB2 07
set $000BEE 00
call 83B94A d=0BAB db=80 p=30
load build/aladdin/states/level1.state
hold B 76
hold RIGHT 36
hold DOWN 64
hold B+RIGHT 16
hold R 59
hold RIGHT 61
hold B+LEFT 79
hold Y+RIGHT 7
hold L 73
press START
wait 60
press START
hold R 31
hold RIGHT 71
hold DOWN 67
hold Y+RIGHT+B 33
hold DOWN 41
hold B+R 75
hold LEFT 27
hold A+RIGHT 19
hold DOWN+A 58
hold B+RIGHT 42
hold UP 68
hold RIGHT 65
hold R 57
hold Y+RIGHT+B 74
hold Y+RIGHT+B 15
hold DOWN+A 17
hold DOWN+A 54
hold RIGHT 64
hold X 79
hold L 25
hold B+LEFT 5
hold UP+B 74
hold DOWN+A 48
hold Y+LEFT 49
hold A 88
hold RIGHT 53
hold DOWN+A 20
hold UP+B 30
hold RIGHT 65
press A 2
wait 4
set 0009D7 92,02
set 0009DA 06,01
set $000C52 07
set $000C8E 00
call 83B94A d=0C4B db=80 p=30
