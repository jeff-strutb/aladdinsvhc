# ActorWaitNothing ($83:91F3), the wait of the kinds that do nothing while
# they wait: an RTS no script reached (those kinds never set bit 7 of their
# $09, which sends the actor loop to the wait table). From the first
# level's state, entered by JSR as from the wait table, D = the pool's
# first record.
load build/aladdin/states/level1.state
wait 10
call 8391F3 d=0B5B db=83 p=30
