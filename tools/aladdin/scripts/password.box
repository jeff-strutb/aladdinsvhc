# The password screen: move the cursor, pick portraits, enter a wrong
# password, then leave.
load build/aladdin/states/title.state
press DOWN
wait 30
press START
wait 120
shot password
repeat 4
press RIGHT
wait 15
press A
wait 30
end
shot entered
wait 300
shot after
repeat 4
press LEFT
wait 15
press B
wait 30
end
press START
wait 300
shot left
