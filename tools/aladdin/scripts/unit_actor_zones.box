# Actor helpers in bank $83 whose branches random play never takes. Each
# call starts from the first level's state (the machine is put back after
# each call; a set applies to the next call only).
load build/aladdin/states/level1.state
wait 10
# ActorZonePlace ($83:879B) with a zone whose x and y offsets are both
# negative (the record at $83:BDA6, offsets $F2 and $A9): the sign
# extensions on both of its facings, the player's record as the actor
# (its flip byte at $08F0 zero, then one).
set 0008F0 00
call 83879B y=0 d=08DB db=83 p=30
set 0008F0 01
call 83879B y=0 d=08DB db=83 p=30
# Spawn11AtY ($83:827D) and Spawn13AtY ($83:82B5) with the second pool
# full (its top offset $15E6 negative): ActorAllocB finds none and the
# registers are pulled back.
set 0015E6 FF
call 83827D x=1234 y=08DB d=08DB db=80 p=20
set 0015E6 FF
call 8382B5 x=1234 y=08DB d=08DB db=80 p=20
# SequencesStep ($81:EC23) at the end of a sequence's list: record 0 at
# $1645 running and started, its wait 1, index 0, length $10 and its list
# at $81:EC23, whose entry at index 3 has a negative wait ($EB): the
# sequence ends (active byte cleared).
set 001645 01,00,10,00,00,01,23,EC,00,00,00,00,01,00,00,00
call 81EC23 d=0000 db=81 p=30
# A shot of the second pool on an actor, which random play reaches for
# few of these routines: the pool's first record ($0B5B) as the actor and
# the second pool's first ($09CB) as the shot, both kind 0, able to be hit
# ($09 bit 6), at the same place (x and y $0100); the shot's $11 $80 (it
# does not hit), then 0 (it hits). ActorDownedByShot ($83:80FC),
# ActorHitByShotCC ($83:8135) and ActorStopsShot ($83:8171) each.
set 000B5B 0C,00,00,00,00,00,00,00,00,40,00,00,00,01,00,00,01
set 0009CB 0C,00,00,00,00,00,00,00,00,40,00,00,00,01,00,00,01,80,00,00,01
call 8380FC d=0B5B db=80 p=30
set 000B5B 0C,00,00,00,00,00,00,00,00,40,00,00,00,01,00,00,01
set 0009CB 0C,00,00,00,00,00,00,00,00,40,00,00,00,01,00,00,01,80,00,00,01
call 838135 d=0B5B db=80 p=30
set 000B5B 0C,00,00,00,00,00,00,00,00,40,00,00,00,01,00,00,01
set 0009CB 0C,00,00,00,00,00,00,00,00,40,00,00,00,01,00,00,01,80,00,00,01
call 838171 d=0B5B db=80 p=30
set 000B5B 0C,00,00,00,00,00,00,00,00,40,00,00,00,01,00,00,01
set 0009CB 0C,00,00,00,00,00,00,00,00,40,00,00,00,01,00,00,01,00,00,00,01
call 8380FC d=0B5B db=80 p=30
set 000B5B 0C,00,00,00,00,00,00,00,00,40,00,00,00,01,00,00,01
set 0009CB 0C,00,00,00,00,00,00,00,00,40,00,00,00,01,00,00,01,00,00,00,01
call 838135 d=0B5B db=80 p=30
set 000B5B 0C,00,00,00,00,00,00,00,00,40,00,00,00,01,00,00,01
set 0009CB 0C,00,00,00,00,00,00,00,00,40,00,00,00,01,00,00,01,00,00,00,01
call 838171 d=0B5B db=80 p=30
# ActorBouncesOrHurtsPlayer ($83:844A) with Aladdin coming down on the
# actor from above, which random play never reaches: the pool's first
# record ($0B5B) as the actor (kind 0, able to be hit, at x $0100 and y
# $3933), the test box at x and y $0100 with no size, so the actor's box
# overlaps it within 10 pixels of its bottom; health 3, $141B zero, $141C
# one, $145A and his vertical speed zero: he is stood on it. Then the
# same with no health (refused).
set 000B5B 0C,00,00,00,00,00,00,00,00,40,00,00,00,01,00,33,39
set 001484 00,01,00,01,00,00,00,00
set 001448 00
set 000367 03
set 00141B 00,01
set 00145A 00
set 0008F9 00,00
call 83844A d=0B5B db=80 p=30
set 000B5B 0C,00,00,00,00,00,00,00,00,40,00,00,00,01,00,33,39
set 001484 00,01,00,01,00,00,00,00
set 001448 00
set 000367 00
call 83844A d=0B5B db=80 p=30
# ActorGrabbableByPlayer ($83:882E) and PlayerFacesActorClose ($83:888C)
# with Aladdin close in front of the actor, which random play never
# reaches: the pool's first record ($0B5B) at x and y $0100, Aladdin at x
# $00F0 and y $0100 facing right. With $1427 set; with it clear and his
# state free ($141B 0, $1448 0, $141C 1), rising 1 pixel a frame, then 16;
# with $1448 8; and with him far to the left.
set 000B5B 0C,00,00,00,00,00,00,00,00,40,00,00,00,01,00,00,01
set 0008E7 F0,00
set 0008EA 00,01
set 0008F0 00
set 001427 01
call 83882E d=0B5B db=80 p=30
set 000B5B 0C,00,00,00,00,00,00,00,00,40,00,00,00,01,00,00,01
set 0008E7 F0,00
set 0008EA 00,01
set 0008F0 00
set 001427 00
set 00141B 00,01
set 001448 00
set 0008F9 FF,FF
call 83882E d=0B5B db=80 p=30
set 000B5B 0C,00,00,00,00,00,00,00,00,40,00,00,00,01,00,00,01
set 0008E7 F0,00
set 0008EA 00,01
set 0008F0 00
set 001427 00
set 00141B 00,01
set 001448 00
set 0008F9 F0,FF
call 83882E d=0B5B db=80 p=30
set 000B5B 0C,00,00,00,00,00,00,00,00,40,00,00,00,01,00,00,01
set 0008E7 F0,00
set 0008EA 00,01
set 0008F0 00
set 001427 00
set 00141B 00,01
set 001448 08
call 83882E d=0B5B db=80 p=30
set 000B5B 0C,00,00,00,00,00,00,00,00,40,00,00,00,01,00,00,01
set 0008E7 00,00
set 0008EA 00,01
set 0008F0 00
call 83882E d=0B5B db=80 p=30
# ActorSolidForPlayer ($83:865E) on paths random play never takes: the
# pool's first record ($0B5B) as a solid actor at x and y $0100, box 0 of
# the table at $80:BD66 (16 by 16 half-sizes), Aladdin not yet on an
# actor. Rising into its bottom (y $010A, x before the move $0100) with
# $141C set, then clear; landing on its top (y $00F4) with no health; and
# pushed out of its right side (x $0108, x before the move far left).
set 000B5B 0C,00,00,00,00,00,00,00,00,40,00,00,00,01,00,00,01
set 001428 00
set 00143B 00,01
set 0008E7 00,01
set 0008EA 0A,01
set 0008F8 00,FF,FF
set 00141C 01
call 83865E y=0 d=0B5B db=80 p=30
set 000B5B 0C,00,00,00,00,00,00,00,00,40,00,00,00,01,00,00,01
set 001428 00
set 00143B 00,01
set 0008E7 00,01
set 0008EA 0A,01
set 0008F8 00,FF,FF
set 00141C 00
call 83865E y=0 d=0B5B db=80 p=30
set 000B5B 0C,00,00,00,00,00,00,00,00,40,00,00,00,01,00,00,01
set 001428 00
set 00143B 00,01
set 0008E7 00,01
set 0008EA F4,00
set 0008F8 00,01,00
set 000367 00
call 83865E y=0 d=0B5B db=80 p=30
set 000B5B 0C,00,00,00,00,00,00,00,00,40,00,00,00,01,00,00,01
set 001428 00
set 00143B 00,00
set 0008E7 08,01
set 0008EA 00,01
call 83865E y=0 d=0B5B db=80 p=30
