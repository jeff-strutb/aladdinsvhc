# The NMI's upload helpers for requests the retail game never makes: the
# flags at $082A-$082D stay 0 and $0845 stays 0 in every mode played, so
# each request is set for its call. DMA outside the vertical blank reaches
# no VRAM or CGRAM, which no check here needs. The first level's state;
# the machine is put back after each call.
load build/aladdin/states/level1.state
wait 10
# UploadCharsets ($80:851B): request 3, then 6 (the two sources $7F:D000
# and $7F:D400): 32 rows of $20 bytes each to VRAM from 0.
set 00082B 03
call 80851B d=0 db=80 p=30
set 00082B 06
call 80851B d=0 db=80 p=30
# UploadStepped ($80:8577): its step 0 (the row cleared, the step on),
# then step 1 (a row of the buffer at $7F:B000 written to VRAM).
set 00082A 01
set 00082E 00
call 808577 d=0 db=80 p=30
set 00082A 01
set 00082E 01
call 808577 d=0 db=80 p=30
# UploadBlockA ($80:869A) and UploadBlockB ($80:86D9): request 7, the
# second entry of each table ($80:B6A2, $80:B6EF).
set 00082C 07
call 80869A d=0 db=80 p=30
set 00082D 07
call 8086D9 d=0 db=80 p=30
# PaletteUpload ($80:874F) with source 6 of the table at $80:B608 (256
# bytes rather than 512).
set 000844 01
set 000845 06
call 80874F d=0 db=80 p=30
