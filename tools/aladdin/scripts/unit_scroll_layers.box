# Scroll layer routines no level runs as a call, or runs only in part.
# Each call starts from the first level's state with the inputs given
# (the machine is put back after each call; pokes before it stay).
load build/aladdin/states/level1.state
wait 10
# EdgeMapPlace ($81:C1A2) is reached only by EdgePlaceAt's tail jump,
# which the per-call check does not watch: called here for the play
# field's right edge at X $0234, Y $0118.
call 81C1A2 a=0234 y=0118 x=000A d=1738 db=80 p=00
# The column draw ($81:C2E0) for a column longer than 32 tiles (the play
# field's column length, $1738 + $28, 34 tiles): copied in two parts.
poke $001760 22
call 81C2E0 y=0 d=1738 db=80 p=30
# The row draw ($81:C383) over an empty block: the play field's bottom
# edge ($1738 + $1E) at block 0, a negative block map entry.
poke $001758 00,00
poke $7FF000 00,80
call 81C383 y=0 d=1738 db=80 p=30
# The camera stops ($81:CA84, CADA) at an empty block, which no level's
# play reaches in the scripts: the scroll X at $0280 after $0290 (moving
# left) and $0270 (moving right), Y $0100, with the blocks at the left
# edge (block map $7F:F086) and the right edge ($7F:F088) empty.
poke $001773 80,02
poke $0019E5 90,02
poke $0019E9 00,01
poke $7FF086 00,80
call 81CA84 db=80 p=00
poke $0019E5 70,02
poke $7FF088 00,80
call 81CA84 db=80 p=00
# The same up ($1777 $0180 after $0190) and down ($0170): the blocks at
# the top edge ($7F:F086, still empty) and the bottom edge ($7F:F0C6).
poke $001777 80,01
poke $0019E9 90,01
call 81CADA db=80 p=00
poke $0019E9 70,01
poke $7FF0C6 00,80
call 81CADA db=80 p=00
