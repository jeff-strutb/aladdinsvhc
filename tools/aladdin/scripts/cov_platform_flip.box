# The kind $47 platform's carry (PlatformCarriesRecordY, $83:CD5E) with
# DIRECTION_FLIP set, which no play has: the top by the other end
# ($83:CDDB), and with DIRECTION 1 the $10 offset ($83:CDE2). The play of
# rand_stage_a1_s1 (seed 7) to frame 280, Aladdin riding the platform at
# record $12DB (frames 268 to 372); its DIRECTION_FLIP ($42, $131D) poked
# to 1 (DIRECTION 0; its wait then flips DIRECTION to 1 and clears it),
# and 20 frames later poked to 1 again. The kind $4B at record $123B
# follows that platform then, so the DIRECTION change is also its $07
# following the record's $40 (Kind4BStart, $83:CE5A).
load build/aladdin/states/stage_a1_s1.state
hold Y+RIGHT 23
hold RIGHT 13
hold LEFT 50
hold DOWN+A 31
hold B+R 57
hold RIGHT 74
hold Y+LEFT 19
hold L 13
poke 00131D 01
wait 20
poke 00131D 01
wait 20
