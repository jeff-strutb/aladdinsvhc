# The tile-slot claims no level reaches: ActorKindTiles ($82:AB3F) for a
# kind whose cell needs three slots and two slots, TileSlotsClaim3
# ($82:AC34) with slot 1 taken (slots 2-4 claimed) and with no run free,
# TileSlotsClaim2 ($82:AC10) with no pair free, and ActorKindTilesQueue
# ($82:AAE7) for kind $33 (X = $66), which only fills the slot. Each from
# the first level's state, entered by JSR as from the kinds' set-ups:
# DB = $82, the kind $10 in scratch $1C (its cell), the kind * 2 in $22,
# the record $08DB in $20; the cell's extra slots ($7F:E900 + kind) and
# the slots' holders ($15E9-$15EC) crafted before each call.
load build/aladdin/states/level1.state
wait 10
# Three slots, slots 1-3 free: TileSlotsClaim3 claims 1-3, then the fill.
set 00001C 10,00
set 000020 DB,08
set 000022 20,00
set 7FE910 02
set 0015E9 00,00,00,00
call 82AB3F db=82 p=30
# Three slots, slot 1 taken: slots 2-4 claimed.
set 00001C 10,00
set 000020 DB,08
set 000022 20,00
set 7FE910 02
set 0015E9 01,00,00,00
call 82AB3F db=82 p=30
# Three slots, slots 1 and 4 taken: no run free, C set.
set 00001C 10,00
set 000020 DB,08
set 000022 20,00
set 7FE910 02
set 0015E9 01,00,00,01
call 82AB3F db=82 p=30
# Two slots, all free: TileSlotsClaim2 claims 1-2, then the fill.
set 00001C 10,00
set 000020 DB,08
set 000022 20,00
set 7FE910 01
set 0015E9 00,00,00,00
call 82AB3F db=82 p=30
# Two slots, slots 2 and 3 taken: no pair free, C set.
set 00001C 10,00
set 000020 DB,08
set 000022 20,00
set 7FE910 01
set 0015E9 00,01,01,00
call 82AB3F db=82 p=30
# ActorKindTilesQueue for kind $33: no queue record, the fill only.
set 00001C 33,00
set 000020 DB,08
set 000022 66,00
call 82AAE7 x=0066 db=82 p=20
