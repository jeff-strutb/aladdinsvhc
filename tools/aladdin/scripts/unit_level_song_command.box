# The level song that is a sound command instead ($81:86EB: an entry
# with bit 7 set in the table at $80:B8EF goes to $81:F9F0, command $F0).
# No level's entry has the bit, so no play reaches it; level $E2 reads
# past the levels to an entry that has it. (The machine is put back
# after the call.)
load build/aladdin/states/level1.state
wait 10
set $00035E E2,00
call 8186DE db=80 p=30
