# The window shape's edges ($81:B2D9) clamped at the screen's sides: its
# centre ($32, $34) within a radius ($2C, $2E) of an edge, which no
# script's play reaches (the shape stays near the screen's middle). The
# centre near the left and bottom, then near the right and top. (The
# machine is put back after each call.)
load build/aladdin/states/level1.state
wait 10
poke $00002C 20,00,30,00
poke $000032 10,00,F0,00
call 81B2D9 d=0 db=80 p=30
poke $000032 F0,00,10,00
call 81B2D9 d=0 db=80 p=30
