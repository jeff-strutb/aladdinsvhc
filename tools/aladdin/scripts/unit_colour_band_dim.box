# The colour-band HDMA table's entries past the 17th dimmed by the step
# ($81:A0A6, the task at $81:A00C writing its table with $81:A08A). The
# table's count in the data bank the task runs with ($80:BA7E) is 17, so
# the dimmed part never runs; with the data bank at $81 the count read
# is $E2. The task's record at slot 0 (D = $6F), its buffer 0 and step 5.
# (The machine is put back after the call.)
load build/aladdin/states/level1.state
wait 10
set $000075 05,00
call 81A08A d=006F db=81 p=30
