# A palette's blink step ($81:9CC8, PaletteBlinkStep): nothing in the
# game calls it, so no screen runs it. Unit calls by JSL on the first
# level's state with D = 0, DB $80, palette 1, M and X 8-bit: the count at
# $4F set to 2 (down to 1, odd: white), to 3 (down to 2, even: the kept
# colours back) and to 0 (nothing). (The machine is put back after each
# call.)
load build/aladdin/states/level1.state
wait 10
set $00004F 02
call 819CC8 long a=01 d=0000 db=80 p=30
set $00004F 03
call 819CC8 long a=01 d=0000 db=80 p=30
set $00004F 00
call 819CC8 long a=01 d=0000 db=80 p=30
