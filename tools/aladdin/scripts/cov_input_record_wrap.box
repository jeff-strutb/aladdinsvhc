# The development recorder (InputRecord, $81:BE5A) holding a run past 255
# frames ($81:BE97: the count kept at $FF and a new run started), which
# needs cartridge RAM that keeps what it is given: with the copier RAM on
# (cartram), the recording mode set ($0331 = 1, its step $0334 = 0) on the
# first level and no button held for 300 frames.
load build/aladdin/states/level1.state
cartram on
poke 000331 01
poke 000334 00
wait 300
