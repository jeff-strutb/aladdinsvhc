# Kind79Wait ($83:F68C), the riser's wait: a shot reaching it ($83:F6C0)
# and Aladdin landing on it ($83:F6C7), which no play gives it (see
# cov_kind79.box for the rest). As unit_shot_answers.box, the first level
# played until an apple is thrown; then two calls of it on the falling
# pot's record ($0C4B, x $0292, y $0106), with its $41 and KIND79_LOW
# ($0C8C, $0C94) 0 and the range point on it:
# 1. the apple ($09CB) moved onto it: the shot;
# 2. the apple moved off, the test box's centre ($1484) at x $0292,
#    y $00E7 (5 pixels into the top of the boxes' 36-pixel half-height
#    sum, under the landing's 10) and V_141C 1: the landing.
load build/aladdin/states/level1.state
hold B 76
hold RIGHT 36
hold DOWN 64
hold B+RIGHT 16
hold R 59
hold RIGHT 61
hold B+LEFT 79
hold Y+RIGHT 7
hold L 73
press START
wait 60
press START
hold R 31
hold RIGHT 71
hold DOWN 67
hold Y+RIGHT+B 33
hold DOWN 41
hold B+R 75
hold LEFT 27
hold A+RIGHT 19
hold DOWN+A 58
hold B+RIGHT 42
hold UP 68
hold RIGHT 65
hold R 57
hold Y+RIGHT+B 74
hold Y+RIGHT+B 15
hold DOWN+A 17
hold DOWN+A 54
hold RIGHT 64
hold X 79
hold L 25
hold B+LEFT 5
hold UP+B 74
hold DOWN+A 48
hold Y+LEFT 49
hold A 88
hold RIGHT 53
hold DOWN+A 20
hold UP+B 30
hold RIGHT 65
press A 2
wait 4
set 0009D7 92,02
set 0009DA 06,01
set 000C8C 00
set 000C94 00
set 001A44 92,02,06,01
call 83F68C d=0C4B db=80 p=30
set 0009D7 00,00
set 0009DA 00,00
set 000C8C 00
set 000C94 00
set 001A44 92,02,06,01
set 001484 92,02,E7,00
set 00141C 01
call 83F68C d=0C4B db=80 p=30
