# Kind $92's second state (Kind92Second, $83:9385: JML Kind91FreeOff),
# which the actor loop jumps to for a kind $92 record in a state with bit 7
# set (the table at $83:8EFD). Kind $92's start ($A5:F5BA) ends it in its
# first run on every path of its $07, so no kind $92 record outlives a
# frame: at frame 30 of stage a5 s1 the waiting kind $97 record $0BAB is
# made kind $92 in state $8C, and 10 frames run.
load build/aladdin/states/stage_a5_s1.state
wait 30
poke 000BB1 92
poke 000BAB 8C
wait 10
