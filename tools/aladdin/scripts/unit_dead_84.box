# ActorList4EFindIdle ($84:8A65), which no code calls (no JSR, JSL, JMP or
# table word reaches it): unit calls at its own entry on the first level at
# frame 10, D the guard ($0BAB), its $4E pointing at record $0B5B. First
# that record idle ($18 0: found, C clear); then busy ($18 1) with its own
# $4E 0 (the list's end: C set). (The machine is put back after each call.)
load build/aladdin/states/level1.state
wait 10
set 000BF9 5B,0B
set 000B73 00
call 848A65 p=30 db=80 d=0BAB
set 000BF9 5B,0B
set 000B73 01
set 000BA9 00,00
call 848A65 p=30 db=80 d=0BAB
