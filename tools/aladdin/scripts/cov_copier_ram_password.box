# The copier checks on the way to the password screen, which this board
# never meets (no cartridge RAM at bank $70): with the copier RAM on
# (cartram), 84:AF7F finds RAM at $70:1522 and sets lives, health and
# $0365 to 1 ($84:AF93), and 81:A3A6's test passes too. Played as
# password.box.
load build/aladdin/states/title.state
cartram on
press DOWN
wait 30
press START
wait 120
repeat 4
press RIGHT
wait 15
press A
wait 30
end
wait 300
repeat 4
press LEFT
wait 15
press B
wait 30
end
press START
wait 300
