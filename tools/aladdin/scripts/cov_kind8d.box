# Actor kind $8D (Kind8DCircle, $84:99ED), which no script reaches: the
# first level's record $092B made one (kind byte +6 $8D, state $0C). It
# starts left of the view, flies to Aladdin, circles him twice, flies off
# for 80 frames and ends.
load build/aladdin/states/level1.state
wait 10
poke 000931 8D
poke 000932 00
poke 00092B 0C
wait 900
