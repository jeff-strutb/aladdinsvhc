# Two wait routines' answers to a shot, which no script's play gives
# them: $83:C94A, stopped by a shot (it sets its $43, $83:C94F), and
# with $07 bit 1 its end test ($83:C95A); $83:F991 (reached by JSL),
# stopped by a shot (it sets its $42, $83:F9A3), and with $07 nonzero its
# $44 test ($83:F9A9). The first level played as unit_pot_hit.box until
# an apple is thrown; then unit calls of each on the falling pot's record
# ($0C4B) with the apple moved onto it as there, and the point actors are
# kept in range of ($1A44) on the pot so that its range test keeps it.
load build/aladdin/states/level1.state
hold B 76
hold RIGHT 36
hold DOWN 64
hold B+RIGHT 16
hold R 59
hold RIGHT 61
hold B+LEFT 79
hold Y+RIGHT 7
hold L 73
press START
wait 60
press START
hold R 31
hold RIGHT 71
hold DOWN 67
hold Y+RIGHT+B 33
hold DOWN 41
hold B+R 75
hold LEFT 27
hold A+RIGHT 19
hold DOWN+A 58
hold B+RIGHT 42
hold UP 68
hold RIGHT 65
hold R 57
hold Y+RIGHT+B 74
hold Y+RIGHT+B 15
hold DOWN+A 17
hold DOWN+A 54
hold RIGHT 64
hold X 79
hold L 25
hold B+LEFT 5
hold UP+B 74
hold DOWN+A 48
hold Y+LEFT 49
hold A 88
hold RIGHT 53
hold DOWN+A 20
hold UP+B 30
hold RIGHT 65
press A 2
wait 4
set 0009D7 92,02
set 0009DA 06,01
set $000C52 00
call 83C94A d=0C4B db=80 p=30
set $000C52 02
set $001A44 92,02,06,01
call 83C94A d=0C4B db=80 p=30
set 0009D7 92,02
set 0009DA 06,01
set $000C52 00
set $000C8E 00
set $001A44 92,02,06,01
call 83F991 long d=0C4B db=80 p=30
set $000C52 01
set $000C8F 00
set $001A44 92,02,06,01
call 83F991 long d=0C4B db=80 p=30
set $000C52 01
set $000C8F 01
set $001A44 92,02,06,01
call 83F991 long d=0C4B db=80 p=30
