# Actor kind $7E (84:91A5, through the stub at $83:92A8): the bouncing
# platforms of stage a4 s1 ($07 0-6 placed from x $04C4), which no play
# reaches (the walk right stops at a wall, x $01FB, far below them). The
# view put at x $0480, y 0 and Aladdin at x $04C4: the placements there
# make records $0C9B and $0D8B ($07 0).
# A. Aladdin dropped onto the first from y $0020: it bounces him (its wait,
# Kind7EWaitWork $84:931C, through ActorBouncesPlayerLong $83:840B, sound
# $12) and holds him above it for 8 frames.
load build/aladdin/states/stage_a4_s1.state
wait 30
poke 001773 80,04
poke 0019E5 80,04
poke 001777 00,00
poke 0019E9 00,00
poke 0008E7 C4,04
poke 0008EA 60,00
wait 45
poke 0008EA 20,00
wait 120
