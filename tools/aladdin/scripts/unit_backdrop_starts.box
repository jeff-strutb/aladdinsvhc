# The level's backdrop start (LevelBackdropStart, $81:8E06) for each level
# whose load no script runs: its entry in the jump table (BACKDROP_STARTS,
# $81:8E0E, one word per level, 0-$43) read and the code it names run
# (the RTSes of levels 1-3, level $17's tilemap clear, the shared RTS).
# Unit calls by JSR on the first level (M and X 8-bit, DB $80), the
# level ($035E) set for each, the machine put back after each.
load build/aladdin/states/level1.state
wait 10
set $00035E 01,00
call 818E06 p=30 db=80
set $00035E 02,00
call 818E06 p=30 db=80
set $00035E 03,00
call 818E06 p=30 db=80
