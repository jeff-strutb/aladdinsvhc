# Asking the free list for more records than it holds: the sort of its
# top A records ($81:ADFC) returns $FF ($81:AE35), and taking a block of
# A bytes of it ($81:AE38) returns with C clear ($81:AE88). The callers
# ($83:C9AF, $84:9FDF) ask for a few records, and the scripts' play never
# has the pool that full. The free list's top set to one record
# ($15E4 = 2), then 5 records asked of the first, 8 bytes of the second.
# (The machine is put back after each call.)
load build/aladdin/states/level1.state
wait 10
set $0015E4 02
call 81ADFC long a=05 db=80 p=30
set $0015E4 02
call 81AE38 long a=08 db=80 p=30
