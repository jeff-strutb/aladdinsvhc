+// Work RAM at $70-$7D and $F0-$FF:0000-7FFF for a cartridge with no save
+// RAM (a copier's), answering only while snesbox_cart_ram_on is set (a
+// script's cartram): open bus otherwise, as the board has none. Its bytes
+// are not in saved states. The harness reads them as the cartram view.
+extern int snesbox_cart_ram_on;
+extern uint8_t snesbox_cart_ram[0x8000];
 void snesbox_cpu_rom(uint32_t offset);
