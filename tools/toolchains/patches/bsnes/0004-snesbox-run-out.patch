+//Run original code from the given state (routine swapping off) until a
+//return (RTS, RTL or RTI) takes the stack pointer above s: code C calls or
+//jumps to, stopped where it leaves its frame, by its own return or through
+//its caller's.
+extern "C" void snesbox_core_run_out(const struct SnesboxRegs* from, uint16_t s) {
+  using namespace SuperFamicom;
+  snesbox_core_set_regs(from);
+  auto exec = snesbox_cpu_exec;
+  snesbox_cpu_exec = nullptr;
+  do { snesbox_cpu_opcode = 0; cpu.main(); }
+  while(cpu.r.s.w <= s || (snesbox_cpu_opcode != 0x60 && snesbox_cpu_opcode != 0x6b && snesbox_cpu_opcode != 0x40));
+  snesbox_cpu_exec = exec;
+}
