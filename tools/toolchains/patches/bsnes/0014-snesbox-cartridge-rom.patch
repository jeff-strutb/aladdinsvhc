--- a/bsnes/sfc/cartridge/load.cpp
+++ b/bsnes/sfc/cartridge/load.cpp
@@ -153,7 +153,17 @@
 //memory(type=ROM,content=Program)
 auto Cartridge::loadROM(Markup::Node node) -> void {
   loadMemory(rom, node, File::Required);
-  for(auto leaf : node.find("map")) loadMap(leaf, rom);
+  //snesbox: the S-CPU's and DMA's reads of a cartridge with no coprocessor
+  //owning the ROM are traced like the Super FX's CPU ROM window; mapped as
+  //loadMap(leaf, rom) maps it (a map with no size takes the ROM's)
+  for(auto leaf : node.find("map")) {
+    uint size = leaf["size"].natural();
+    if(size == 0) size = rom.size();
+    bus.map(
+      [&](uint addr, uint8 data) -> uint8 { snesbox_cpu_rom(addr); return rom.read(addr, data); },
+      [&](uint addr, uint8 data) -> void { rom.write(addr, data); },
+      leaf["address"].text(), size, leaf["base"].natural(), leaf["mask"].natural());
+  }
 }
 
