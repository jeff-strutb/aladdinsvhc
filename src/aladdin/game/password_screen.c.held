    sta16(ea_dp(0xAA));  /* 84AE34 sta */
    op_sep(0x20);  /* 84AE36 sep */
    MEM8(inc, ea_abs(SCRATCH));  /* 84AE38 inc */
    lda8(ea_abs(SCRATCH));  /* 84AE3B lda */
    cmp8_v(0x08);  /* 84AE3E cmp */
    if (!IF_Z) goto L_84AE24;  /* 84AE40 bne */
