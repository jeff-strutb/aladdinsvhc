L_84AE61:
    bit8_i(0x08);  /* 84AE61 bit */
    if (IF_Z) goto L_84AE73;  /* 84AE63 beq */
    ldx8(ea_dp(0xA5));  /* 84AE65 ldx */
    MEM8(inc, ea_dpx(0xA6));  /* 84AE67 inc */
    lda8(ea_dpx(0xA6));  /* 84AE69 lda */
    cmp8_v(0x06);  /* 84AE6B cmp */
    if (!IF_Z) goto L_84AE81;  /* 84AE6D bne */
    lda8_v(0x00);  /* 84AE6F lda */
    goto L_84AE81;  /* 84AE71 bra */
L_84AE73:
    bit8_i(0x04);  /* 84AE73 bit */
    if (IF_Z) goto L_84AE94;  /* 84AE75 beq */
    ldx8(ea_dp(0xA5));  /* 84AE77 ldx */
    MEM8(dec, ea_dpx(0xA6));  /* 84AE79 dec */
    lda8(ea_dpx(0xA6));  /* 84AE7B lda */
    if (!IF_N) goto L_84AE81;  /* 84AE7D bpl */
    lda8_v(0x05);  /* 84AE7F lda */
L_84AE81:
    sta8(ea_dpx(0xA6));  /* 84AE81 sta */
    sta8(ea_abs(0x000F));  /* 84AE83 sta */
    stx8(ea_abs(0x000E));  /* 84AE86 stx */
    abi_PasswordPictureDraw();  /* 84AE89 jsr */
    lda8_v(0x0C);  /* 84AE8C lda */
    abi_SoundQueueAdd();  /* 84AE8E jsl */
    goto L_84AEAE;  /* 84AE92 bra */
L_84AE94:
    bit8_i(0x02);  /* 84AE94 bit */
    if (IF_Z) goto L_84AE9C;  /* 84AE96 beq */
    MEM8(inc, ea_dp(0xA5));  /* 84AE98 inc */
    goto L_84AEA2;  /* 84AE9A bra */
L_84AE9C:
    bit8_i(0x01);  /* 84AE9C bit */
    if (IF_Z) goto L_84AEAE;  /* 84AE9E beq */
    MEM8(dec, ea_dp(0xA5));  /* 84AEA0 dec */
L_84AEA2:
    lda8(ea_dp(0xA5));  /* 84AEA2 lda */
    and8_v(0x03);  /* 84AEA4 and */
    sta8(ea_dp(0xA5));  /* 84AEA6 sta */
    lda8_v(0x0C);  /* 84AEA8 lda */
